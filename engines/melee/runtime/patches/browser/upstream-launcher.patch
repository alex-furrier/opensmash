+#ifndef OPENSMASH_SOURCE_PIVOT_H
+#define OPENSMASH_SOURCE_PIVOT_H
+/* Opt-in source-shaped FK. Matrices are row-major 3x4 target skin deltas.
+ * No target joint mutation, allocation, camera transform, or global state. */
+#include <math.h>
+#define SP_MAX_BONES 128
+static float sp_dot(const float a[3],const float b[3]) {
+    return a[0]*b[0]+a[1]*b[1]+a[2]*b[2];
+}
+static int sp_unit(float v[3]) {
+    float n=sqrtf(sp_dot(v,v));
+    if(!isfinite(n)||n<1e-6f)return 0;
+    for(int k=0;k<3;k++)v[k]/=n;
+    return 1;
+}
+static int sp_rotation(const float m[12],float r[9]) {
+    float x[3]={m[0],m[4],m[8]},y[3]={m[1],m[5],m[9]};
+    float z[3]={m[2],m[6],m[10]};
+    for(int k=0;k<12;k++)if(!isfinite(m[k]))return 0;
+    if(!sp_unit(x))return 0;
+    float d=sp_dot(x,y);for(int k=0;k<3;k++)y[k]-=d*x[k];
+    if(!sp_unit(y))return 0;
+    float cross[3]={x[1]*y[2]-x[2]*y[1],x[2]*y[0]-x[0]*y[2],x[0]*y[1]-x[1]*y[0]};
+    /* Reflection/collapsed scale cannot be silently interpreted as rotation. */
+    if(sp_dot(cross,z)<1e-6f)return 0;
+    for(int k=0;k<3;k++){r[k*3]=x[k];r[k*3+1]=y[k];r[k*3+2]=cross[k];}
+    return 1;
+}
+/* Optional stable four-paw body: use model root motion and remove target
+ * pelvis posture from limb rotation deltas. Source rest anatomy is untouched. */
+static int sp_stabilize_body(unsigned count,unsigned body,float (*driver)[12]) {
+    if(!count||count>SP_MAX_BONES||body==0||body>=count)return 0;
+    float root[9],pelvis[9];
+    if(!sp_rotation(driver[0],root)||!sp_rotation(driver[body],pelvis))return 0;
+    float basis[9]={0};
+    for(int r=0;r<3;r++)for(int c=0;c<3;c++)for(int k=0;k<3;k++)
+        basis[r*3+c]+=root[r*3+k]*pelvis[c*3+k];
+    for(unsigned i=1;i<count;i++) {
+        float rotation[9],corrected[9]={0};
+        if(!sp_rotation(driver[i],rotation))return 0;
+        for(int r=0;r<3;r++)for(int c=0;c<3;c++)for(int k=0;k<3;k++)
+            corrected[r*3+c]+=basis[r*3+k]*rotation[k*3+c];
+        for(int r=0;r<3;r++)for(int c=0;c<3;c++)driver[i][r*4+c]=corrected[r*3+c];
+    }
+    return 1;
+}
+static int sp_reconstruct(unsigned count,const int* parent,
+                          const float (*origin)[3],const float (*driver)[12],
+                          float (*out)[12]) {
+    if(!count||count>SP_MAX_BONES||parent[0]!=-1)return 0;
+    float rotations[SP_MAX_BONES][9],world[SP_MAX_BONES][9],position[SP_MAX_BONES][3];
+    for(unsigned i=0;i<count;i++) {
+        if(i&& (parent[i]<0||(unsigned)parent[i]>=i))return 0;
+        for(int k=0;k<3;k++)if(!isfinite(origin[i][k]))return 0;
+        if(!sp_rotation(driver[i],rotations[i]))return 0;
+        if(!i) {
+            for(int k=0;k<9;k++)world[i][k]=rotations[i][k];
+            for(int r=0;r<3;r++) {
+                position[i][r]=driver[i][r*4+3];
+                for(int c=0;c<3;c++)position[i][r]+=world[i][r*3+c]*origin[i][c];
+            }
+        } else {
+            unsigned p=(unsigned)parent[i];float relative[9]={0};
+            /* Remove the parent's target rotation, then articulate on source FK. */
+            for(int r=0;r<3;r++)for(int c=0;c<3;c++)for(int k=0;k<3;k++)
+                relative[r*3+c]+=rotations[p][k*3+r]*rotations[i][k*3+c];
+            for(int r=0;r<3;r++)for(int c=0;c<3;c++) {
+                world[i][r*3+c]=0;
+                for(int k=0;k<3;k++)world[i][r*3+c]+=world[p][r*3+k]*relative[k*3+c];
+            }
+            for(int r=0;r<3;r++) {
+                position[i][r]=position[p][r];
+                for(int c=0;c<3;c++)position[i][r]+=world[p][r*3+c]*(origin[i][c]-origin[p][c]);
+            }
+        }
+        for(int r=0;r<3;r++) {
+            out[i][r*4+3]=position[i][r];
+            for(int c=0;c<3;c++) {
+                out[i][r*4+c]=world[i][r*3+c];
+                out[i][r*4+3]-=world[i][r*3+c]*origin[i][c];
+            }
+            if(!isfinite(out[i][r*4+3]))return 0;
+        }
+    }
+    return 1;
+}
+#endif
