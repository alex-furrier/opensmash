@@ -0,0 +1,145 @@
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Exercise the actual browser gate against actual upstream raw-queue functions.
+
+Only JS suspension, platform services and the engine snapshot provider are mocked.
+No engine build, browser, asset or networking is needed.
+"""
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def function(source, signature):
+    start = source.index(signature)
+    opening = source.index('{', start)
+    depth, end = 1, opening + 1
+    while depth:
+        depth += (source[end] == '{') - (source[end] == '}')
+        end += 1
+    return source[start:end]
+
+
+class ConfirmedInputTest(unittest.TestCase):
+    def test_actual_queue_suspension_consumption_and_fail_stop(self):
+        gate = (ROOT / 'platforms/browser/confirmed_input.c').read_text()
+        gate = re.sub(r'^#include .*\n', '', gate, flags=re.M)
+        gate = re.sub(r'EM_ASYNC_JS\(int, confirmed_input_wait,.*?^\}\);', 'int confirmed_input_wait(unsigned,const int32_t*,const uint32_t*,int32_t*);', gate, flags=re.M | re.S)
+        gate = re.sub(r'EM_ASYNC_JS\(int, confirmed_input_applied,.*?^\}\);', 'int confirmed_input_applied(unsigned,const int32_t*,const uint32_t*);', gate, flags=re.M | re.S)
+        controller = (ROOT / 'src/sysdolphin/baselib/controller.c').read_text()
+        header = (ROOT / 'src/sysdolphin/baselib/controller.h').read_text()
+        pad_header = (ROOT / 'src/sdk_include/dolphin/pad.h').read_text()
+        pad = pad_header[pad_header.index('typedef struct PADStatus {'):pad_header.index('} PADStatus;') + len('} PADStatus;')]
+        data = function(header, 'struct HSD_PadData {') + ';'
+        lib = function(header, 'struct PadLibData {') + ';'
+        queue_functions = '\n'.join(function(controller, signature) for signature in [
+            'static void HSD_PadRawQueueShift(', 'static void HSD_PadRawMerge(',
+            'void HSD_PadRenewRawStatus(', 'void HSD_PadFlushQueue('])
+        # The exact consumption prefix, including the candidate observer call.
+        master = function(controller, 'void HSD_PadRenewMasterStatus(')
+        master = master[:master.index('        for (i = 0;')] + '\n    }\n    OSRestoreInterrupts(intr);\n}'
+        program = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <signal.h>
+typedef uint8_t u8; typedef int8_t s8; typedef uint16_t u16;
+typedef uint32_t u32; typedef int32_t s32; typedef float f32;
+#define EMSCRIPTEN_KEEPALIVE
+#define __EMSCRIPTEN__ 1
+struct RumbleInfo {int unused;};
+typedef struct HSD_PadData HSD_PadData;
+typedef struct PadLibData PadLibData;
+typedef struct {int unused;} HSD_PadStatus;
+typedef enum {HSD_PAD_FLUSH_QUEUE_MERGE,HSD_PAD_FLUSH_QUEUE_THROWAWAY,
+ HSD_PAD_FLUSH_QUEUE_LEAVE1,HSD_PAD_FLUSH_QUEUE_TERMINATE} HSD_FlushType;
+''' + pad + '\n' + data + '\n' + lib + r'''
+PadLibData HSD_PadLibData;
+HSD_PadStatus HSD_PadMasterStatus[4];
+HSD_PadData queue[4];
+static int fault,callbacks,waits,native_active;
+static uint32_t seed=17; uint32_t* HSD_RandSeedPtr=&seed;
+static float snapshot[48];
+float* direct_snapshot(void){return snapshot;}
