diff --git a/platforms/browser/confirmed_input.c b/platforms/browser/confirmed_input.c
new file mode 100644
index 0000000..82db9f1
--- /dev/null
+++ b/platforms/browser/confirmed_input.c
@@ -0,0 +1,141 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later */
+/* Optional confirmed-input gate. The existing scene loop still owns each tick. */
+#include "pc/compat.h"
+#include "pc/net.h"
+#include <sysdolphin/baselib/controller.h>
+#include <sysdolphin/baselib/random.h>
+#include <emscripten.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+enum { PAD_FIELDS = 10, PAD_VALUES = 4 * PAD_FIELDS, STATE_VALUES = 50 };
+static unsigned s_tick;
+static int s_pending, s_consumed;
+static int32_t s_expected[PAD_VALUES], s_applied[PAD_VALUES];
+extern float* direct_snapshot(void);
+extern unsigned direct_scene_kind(void);
+
+EMSCRIPTEN_KEEPALIVE int opensmash_confirmed_input_version(void) { return 1; }
+
+int browser_confirmed_input_enabled(void)
+{
+    const char* value = getenv("MELEE_BROWSER_CONFIRMED_INPUT");
+    return value && strcmp(value, "1") == 0;
+}
+
+static void pack_pad(const PADStatus* p, int32_t* out)
+{
+    out[0] = p->button; out[1] = p->stickX; out[2] = p->stickY;
+    out[3] = p->substickX; out[4] = p->substickY;
+    out[5] = p->triggerLeft; out[6] = p->triggerRight;
+    out[7] = p->analogA; out[8] = p->analogB; out[9] = p->err;
+}
+
+static void unpack_pad(const int32_t* in, PADStatus* p)
+{
+    if (in[0] < 0 || in[0] > 65535 || in[9] < -3 || in[9] > 0) abort();
+    for (int i = 1; i <= 4; i++) if (in[i] < -128 || in[i] > 127) abort();
+    for (int i = 5; i <= 8; i++) if (in[i] < 0 || in[i] > 255) abort();
+    memset(p, 0, sizeof(*p));
+    p->button = in[0]; p->stickX = in[1]; p->stickY = in[2];
+    p->substickX = in[3]; p->substickY = in[4];
+    p->triggerLeft = in[5]; p->triggerRight = in[6];
+    p->analogA = in[7]; p->analogB = in[8]; p->err = in[9];
+}
+
+/* Explicit selected state: RNG, scene kind, and upstream's four 12-float
+ * player snapshots (presence/kind/action/position/velocity/facing/damage/stocks/
+ * animation frame). Raw float bits avoid rounded text. Never a full snapshot. */
+static void selected_state(uint32_t* out)
+{
+    out[0] = *HSD_RandSeedPtr;
+    out[1] = direct_scene_kind();
+    memcpy(out + 2, direct_snapshot(), 48 * sizeof(uint32_t));
+}
+
+EM_ASYNC_JS(int, confirmed_input_wait,
+    (unsigned tick, const int32_t* local, const uint32_t* state, int32_t* result), {
+    try {
+        if (typeof Module.onConfirmedInput !== 'function') throw Error('Confirmed-input callback missing');
+        const own = Array.from(HEAP32.subarray(local >> 2, (local >> 2) + 10));
+        const selected = Array.from(HEAPU32.subarray(state >> 2, (state >> 2) + 50));
+        const pads = await Module.onConfirmedInput(tick, own, selected);
+        const limits = [[0,65535],[-128,127],[-128,127],[-128,127],[-128,127],
+            [0,255],[0,255],[0,255],[0,255],[-3,0]];
+        if (!Array.isArray(pads) || pads.length !== 4 || !pads.every(p =>
+            Array.isArray(p) && p.length === 10 && p.every((n,i) =>
+                Number.isInteger(n) && n >= limits[i][0] && n <= limits[i][1])))
+            throw Error('Invalid confirmed PADStatus');
+        HEAP32.set(pads.flat(), result >> 2);
+        return 1;
+    } catch (error) {
+        Module.onConfirmedInputError?.(String(error?.message || error));
+        return 0;
+    }
+});
+
+EM_ASYNC_JS(int, confirmed_input_applied,
+    (unsigned tick, const int32_t* pads, const uint32_t* state), {
+    try {
+        if (typeof Module.onConfirmedTick !== 'function') throw Error('Applied callback missing');
+        await Module.onConfirmedTick(tick,
+            Array.from(HEAP32.subarray(pads >> 2, (pads >> 2) + 40)),
+            Array.from(HEAPU32.subarray(state >> 2, (state >> 2) + 50)));
+        return 1;
+    } catch (error) {
+        Module.onConfirmedInputError?.(String(error?.message || error));
+        return 0;
+    }
+});
+
+void browser_confirmed_input_before_tick(void)
+{
+    if (!browser_confirmed_input_enabled()) return;
+    static const char* incompatible[] = {"MELEE_NET_RECORD", "MELEE_NET_REPLAY", "MELEE_NET_SYNCTEST"};
+    if (s_pending || pc_net_active()) abort();
+    for (unsigned i = 0; i < sizeof(incompatible) / sizeof(incompatible[0]); i++)
+        if (getenv(incompatible[i])) abort();
+    PadLibData* p = &HSD_PadLibData;
+    if (!p->queue || !p->qnum || !p->qcount) abort();
+    HSD_PadFlushQueue(HSD_PAD_FLUSH_QUEUE_LEAVE1);
+    unsigned read = p->qread;
+    unsigned capacity = p->qnum;
+    HSD_PadData* queue = p->queue;
+    int32_t local[PAD_FIELDS];
+    uint32_t state[STATE_VALUES];
+    pack_pad(&p->queue->stat[read * 4], local); /* physical controller 0 */
+    selected_state(state);
+    p->qtype = 2; /* a full queue drops new samples instead of shifting its head */
+    if (!confirmed_input_wait(s_tick, local, state, s_expected)) abort();
+    if (!p->qcount || p->qread != read || p->qtype != 2 || p->qnum != capacity || p->queue != queue) abort();
+    /* Physical samples may have filled unused tail entries while suspended.
+     * Retain the confirmed head, discard only that tail; never leave stale ticks. */
+    p->qcount = 1;
+    p->qwrite = (read + 1) % p->qnum;
+    for (int port = 0; port < 4; port++)
+        unpack_pad(s_expected + port * PAD_FIELDS, &p->queue->stat[read * 4 + port]);
+    s_consumed = 0;
+    s_pending = 1;
+}
+
+/* Called at actual raw-head consumption, before HSD clamps/converts inputs. */
+void browser_confirmed_input_consumed(const PADStatus* pads)
+{
+    if (!s_pending) return;
+    if (s_consumed) abort();
+    for (int port = 0; port < 4; port++) pack_pad(pads + port, s_applied + port * PAD_FIELDS);
+    if (memcmp(s_expected, s_applied, sizeof(s_expected))) abort();
+    s_consumed = 1;
+}
+
+void browser_confirmed_input_after_tick(void)
+{
+    if (!browser_confirmed_input_enabled()) return;
+    if (!s_pending || !s_consumed) abort();
+    uint32_t state[STATE_VALUES];
+    selected_state(state);
+    if (!confirmed_input_applied(s_tick, s_applied, state)) abort();
+    s_pending = 0;
+    if (++s_tick == 0) abort();
+}
diff --git a/tests/browser/test_confirmed_input.py b/tests/browser/test_confirmed_input.py
